<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.atlas.hybrid</groupId>
        <artifactId>atlas-hybrid-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>atlas-hybrid-plugin-en</artifactId>
    <name>Atlas Hybrid :: Plugin :: English greeting</name>
    <description>English greeting plugin (service.ranking 20, overrides the Spanish one while installed)</description>

    <dependencies>
        <dependency>
            <groupId>org.atlas.hybrid</groupId>
            <artifactId>atlas-hybrid-greeting-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Private third-party dependency (and its transitive commons-lang3): compile scope so bnd can
            embed the packages the plugin really uses. They are NOT exported and NOT deployed separately,
            so each plugin can carry its own version without clashing with others (see plugin-development.md).
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.13.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
                <configuration>
                    <bnd><![CDATA[
# Copy into the bundle only the packages of these libraries reachable from the plugin code
-conditionalpackage: org.apache.commons.text.*, org.apache.commons.lang3.*
]]></bnd>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <!-- Use the OSGi manifest generated by bnd -->
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
